{
  "manifest_version": 3,
  "name": "Desktop AI Assistant",
  "version": "0.2.0",
  "description": "Edit the focused text with your local Desktop AI Assistant.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Connect Desktop AI Assistant",
    "default_popup": "popup.html"
  },
  "key": ""
}
